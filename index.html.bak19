<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore-compat.js"></script>
<script>
const firebaseConfig = {
  apiKey: "AIzaSyC_iYADCUCDN1pCl3j4-jeZT3pU2XcIydU",
  authDomain: "manz-4d272.firebaseapp.com",
  projectId: "manz-4d272",
  storageBucket: "manz-4d272.firebasestorage.app",
  messagingSenderId: "431533009387",
  appId: "1:431533009387:web:72a9855b0bd596f37911ae"
};
firebase.initializeApp(firebaseConfig);
const auth = firebase.auth();
const db = firebase.firestore();
</script>

<script>
const authToggle=document.getElementById('auth-toggle');
const authPanel=document.getElementById('authPanel');
const authPanelClose=document.getElementById('authPanel-close');
if(authPanelClose) authPanelClose.addEventListener('click',()=>{authPanel.style.display='none';});
document.addEventListener('click',(e)=>{
if(authPanel.style.display!=='none' && !authPanel.contains(e.target) && !authToggle.contains(e.target)){
authPanel.style.display='none';
}
});
const authTabs=document.querySelectorAll('.auth-tab');
const authLoginForm=document.getElementById('authLoginForm');
const authRegisterForm=document.getElementById('authRegisterForm');
const loginEmail=document.getElementById('loginEmail');
const loginPass=document.getElementById('loginPass');
const loginSubmit=document.getElementById('loginSubmit');
const regName=document.getElementById('regName');
const regEmail=document.getElementById('regEmail');
const regPass=document.getElementById('regPass');
const registerSubmit=document.getElementById('registerSubmit');
const authError=document.getElementById('authError');
const logoutBtn=document.getElementById('logoutBtn');
const ownerBadge=document.getElementById('ownerBadge');
const verifiedBadge=document.getElementById('verifiedBadge');
const EYE_ICON='<svg viewBox="0 0 24 24" class="icon"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>';
const EYEOFF_ICON='<svg viewBox="0 0 24 24" class="icon"><path d="M3 3l18 18"/><path d="M9.9 4.2A11 11 0 0112 4c7 0 11 7 11 7a13.6 13.6 0 01-3.4 4.1M6.1 6.1A13.6 13.6 0 001 11s4 7 11 7a10.8 10.8 0 004.9-1.1"/><path d="M9.5 9.9a3 3 0 004.1 4.2"/></svg>';
const CROWN_ICON='<svg viewBox="0 0 24 24" class="icon"><path d="M3 18h18l-1.5-9-4.5 4-3-6-3 6-4.5-4L3 18z"/></svg>';

function showAuthError(msg){ authError.textContent=msg; authError.style.display='block'; }
function clearAuthError(){ authError.style.display='none'; }

authTabs.forEach(tab=>{
tab.addEventListener('click',()=>{
authTabs.forEach(t=>t.classList.toggle('active',t===tab));
const which=tab.dataset.authTab;
authLoginForm.style.display=which==='login'?'flex':'none';
authRegisterForm.style.display=which==='register'?'flex':'none';
clearAuthError();
});
});

authToggle.addEventListener('click',()=>{
if(typeof closeSidebar==='function') closeSidebar();
authPanel.style.display = authPanel.style.display==='none' ? 'flex' : 'none';
});

registerSubmit.addEventListener('click', async ()=>{
clearAuthError();
const name=regName.value.trim();
const email=regEmail.value.trim();
const pass=regPass.value;
if(!name||!email||pass.length<6){ showAuthError('Isi nama, email, dan password minimal 6 karakter.'); return; }
registerSubmit.disabled=true;
try{
const cred=await auth.createUserWithEmailAndPassword(email,pass);
await db.collection('users').doc(cred.user.uid).set({
name:name, email:email, isAdmin:false, createdAt:firebase.firestore.FieldValue.serverTimestamp()
});
}catch(e){ showAuthError(e.message||'Daftar gagal.'); }
finally{ registerSubmit.disabled=false; }
});

loginSubmit.addEventListener('click', async ()=>{
clearAuthError();
const email=loginEmail.value.trim();
const pass=loginPass.value;
if(!email||!pass){ showAuthError('Isi email dan password.'); return; }
loginSubmit.disabled=true;
try{ await auth.signInWithEmailAndPassword(email,pass); }
catch(e){ showAuthError(e.message||'Masuk gagal.'); }
finally{ loginSubmit.disabled=false; }
});

logoutBtn.addEventListener('click',()=>{ auth.signOut(); });

document.querySelectorAll('.pass-eye[data-eye-for]').forEach(btn=>{
btn.addEventListener('click',()=>{
const input=document.getElementById(btn.dataset.eyeFor);
const isPass=input.type==='password';
input.type=isPass?'text':'password';
btn.innerHTML=isPass?EYEOFF_ICON:EYE_ICON;
});
});

const badgeAvatar=document.getElementById('badgeAvatar');
const badgeText=document.getElementById('badgeText');
const profileEditor=document.getElementById('profileEditor');
const profileAvatarPreview=document.getElementById('profileAvatarPreview');
const profileNameInput=document.getElementById('profileNameInput');
const profilePhotoInput=document.getElementById('profilePhotoInput');
const profileSaveBtn=document.getElementById('profileSaveBtn');
const profileSavedMsg=document.getElementById('profileSavedMsg');

function renderAvatar(container, name, photoURL){
container.innerHTML='';
if(photoURL){
const img=document.createElement('img');
img.src=photoURL;
img.alt='avatar';
img.onerror=function(){ renderAvatar(container, name, ''); };
container.appendChild(img);
}else{
container.textContent=(name||'?').trim().charAt(0).toUpperCase()||'?';
}
}

auth.onAuthStateChanged(async (user)=>{
if(user){
authPanel.style.display='none';
logoutBtn.style.display='block';
profileEditor.style.display='flex';
authTabs.forEach(t=>t.style.display='none');
authLoginForm.style.display='none';
authRegisterForm.style.display='none';
let isAdmin=false, name=user.email, photoURL='';
try{
const doc=await db.collection('users').doc(user.uid).get();
if(doc.exists){ const data=doc.data(); isAdmin=!!data.isAdmin; name=data.name||name; photoURL=data.photoURL||''; }
}catch(e){}
if(isAdmin){
badgeText.innerHTML=CROWN_ICON+' OWNER';
ownerBadge.classList.add('owner-role');
verifiedBadge.classList.add('owner-role');
}else{
badgeText.textContent=name;
ownerBadge.classList.remove('owner-role');
verifiedBadge.classList.remove('owner-role');
}
renderAvatar(badgeAvatar, name, photoURL);
renderAvatar(profileAvatarPreview, name, photoURL);
profileNameInput.value=name;
profilePhotoInput.value=photoURL;
window.currentUserProfile={uid:user.uid, isAdmin:isAdmin, name:name, photoURL:photoURL};
}else{
badgeText.textContent='Tamu';
badgeAvatar.textContent='?';
ownerBadge.classList.remove('owner-role');
verifiedBadge.classList.remove('owner-role');
logoutBtn.style.display='none';
profileEditor.style.display='none';
authTabs.forEach(t=>t.style.display='block');
authLoginForm.style.display='flex';
authRegisterForm.style.display='none';
window.currentUserProfile=null;
}
});

profileSaveBtn.addEventListener('click', async ()=>{
const user=auth.currentUser;
if(!user) return;
const newName=profileNameInput.value.trim();
const newPhoto=profilePhotoInput.value.trim();
if(!newName){ return; }
profileSaveBtn.disabled=true;
try{
await db.collection('users').doc(user.uid).update({name:newName, photoURL:newPhoto});
const isAdmin=window.currentUserProfile?window.currentUserProfile.isAdmin:false;
if(isAdmin){ badgeText.innerHTML=CROWN_ICON+' OWNER'; } else { badgeText.textContent=newName; }
renderAvatar(badgeAvatar, newName, newPhoto);
renderAvatar(profileAvatarPreview, newName, newPhoto);
window.currentUserProfile={uid:user.uid, isAdmin:isAdmin, name:newName, photoURL:newPhoto};
profileSavedMsg.style.display='block';
setTimeout(()=>{ profileSavedMsg.style.display='none'; }, 2000);
}catch(e){
alert('Gagal simpan profil: '+(e.message||'coba lagi'));
}finally{
profileSaveBtn.disabled=false;
}
});

const themeToggle=document.getElementById('theme-toggle');
const SUN_ICON='<svg viewBox="0 0 24 24" class="icon"><circle cx="12" cy="12" r="4"/><line x1="12" y1="2" x2="12" y2="4"/><line x1="12" y1="20" x2="12" y2="22"/><line x1="4" y1="12" x2="2" y2="12"/><line x1="22" y1="12" x2="20" y2="12"/><line x1="5" y1="5" x2="6.4" y2="6.4"/><line x1="17.6" y1="17.6" x2="19" y2="19"/><line x1="5" y1="19" x2="6.4" y2="17.6"/><line x1="17.6" y1="6.4" x2="19" y2="5"/></svg>';
const MOON_ICON='<svg viewBox="0 0 24 24" class="icon"><path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"/></svg>';
themeToggle.addEventListener('click',()=>{
const light=document.body.classList.toggle('light-mode');
themeToggle.innerHTML=light?MOON_ICON:SUN_ICON;
});

const navBtns=document.querySelectorAll('.nav-btn[data-tab]');
const tabs=document.querySelectorAll('.tab');
function showTab(id){
tabs.forEach(t=>t.classList.toggle('active',t.id===id));
navBtns.forEach(b=>{b.classList.toggle('active',b.dataset.tab===id);b.classList.toggle('home',b.dataset.tab===id);});
window.scrollTo({top:0});
}

const sidebar=document.getElementById('sidebar');
const sidebarOverlay=document.getElementById('sidebarOverlay');
const menuToggle=document.getElementById('menu-toggle');
const sidebarClose=document.getElementById('sidebar-close');
function openSidebar(){sidebar.classList.add('active');sidebarOverlay.classList.add('active');}
function closeSidebar(){sidebar.classList.remove('active');sidebarOverlay.classList.remove('active');}
if(menuToggle) menuToggle.addEventListener('click',openSidebar);
if(sidebarClose) sidebarClose.addEventListener('click',closeSidebar);
if(sidebarOverlay) sidebarOverlay.addEventListener('click',closeSidebar);

navBtns.forEach(b=>b.addEventListener('click',()=>{showTab(b.dataset.tab);closeSidebar();}));

const toolCards=document.querySelectorAll('.tool-card[data-tool]');
const toolOverlay=document.getElementById('toolOverlay');
const toolFrame=document.getElementById('toolFrame');
const toolClose=document.getElementById('toolClose');
toolCards.forEach(c=>{
c.addEventListener('click',()=>{
toolFrame.src=c.dataset.tool;
toolOverlay.classList.add('active');
document.body.style.overflow='hidden';
});
});
if(toolClose) toolClose.addEventListener('click',()=>{
toolOverlay.classList.remove('active');
toolFrame.src='';
document.body.style.overflow='';
});

document.getElementById('year').textContent=new Date().getFullYear();
document.getElementById('form').addEventListener('submit',e=>{
e.preventDefault();
const d=new FormData(e.currentTarget);
const subject=encodeURIComponent('Pesan portofolio dari '+d.get('name'));
const body=encodeURIComponent('Nama: '+d.get('name')+'\nEmail: '+d.get('email')+'\n\n'+d.get('message'));
document.getElementById('status').textContent='Membuka aplikasi email...';
location.href='mailto:mannzz144hz@gmail.com?subject='+subject+'&body='+body;
});
</script>
<script>if('serviceWorker' in navigator)addEventListener('load',()=>navigator.serviceWorker.register('/sw.js'))</script><script id="mz-profile">
(function(){
  var els = {
    avatar: document.getElementById('upAvatar'),
    name: document.getElementById('upName'),
    badge: document.getElementById('upBadge'),
    email: document.getElementById('upEmail'),
    role: document.getElementById('upRole'),
    joined: document.getElementById('upJoined'),
    edit: document.getElementById('upEdit'),
    logout: document.getElementById('upLogout')
  };
  if (!els.avatar || typeof auth === 'undefined') return;

  var BADGE = '<svg viewBox="0 0 24 24" class="badge-icon"><path fill="currentColor" d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/><path fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="m9 12 2 2 4-4"/></svg>';

  function render(user, data) {
    if (!user) {
      renderAvatar(els.avatar, '?', '');
      els.name.textContent = 'Tamu';
      els.badge.innerHTML = '';
      els.email.textContent = 'Masuk untuk melihat dan mengatur profilmu.';
      els.role.textContent = 'Tamu';
      els.joined.textContent = '-';
      els.edit.textContent = 'Masuk / Daftar';
      els.logout.style.display = 'none';
      return;
    }
    var name = (data && data.name) || user.displayName || user.email || 'Pengguna';
    var photo = (data && data.photoURL) || '';
    var isAdmin = !!(data && data.isAdmin);
    renderAvatar(els.avatar, name, photo);
    els.name.textContent = name;
    els.badge.innerHTML = '<span class="verified-badge2' + (isAdmin ? ' owner-role' : '') + '">' + BADGE + '</span>';
    els.email.textContent = user.email || '';
    els.role.textContent = isAdmin ? 'Owner' : 'Member';
    var d = null;
    if (data && data.createdAt && data.createdAt.toDate) d = data.createdAt.toDate();
    else if (user.metadata && user.metadata.creationTime) d = new Date(user.metadata.creationTime);
    els.joined.textContent = d ? d.toLocaleDateString('id-ID', {day:'numeric', month:'short', year:'numeric'}) : '-';
    els.edit.textContent = 'Edit Profil';
    els.logout.style.display = 'inline-block';
  }

  async function load(user) {
    if (!user) { render(null, null); return; }
    var data = null;
    try {
      var doc = await db.collection('users').doc(user.uid).get();
      if (doc.exists) data = doc.data();
    } catch (e) {}
    render(user, data);
  }

  auth.onAuthStateChanged(load);

  var saved = document.getElementById('profileSavedMsg');
  if (saved) {
    new MutationObserver(function(){
      if (saved.style.display === 'block') load(auth.currentUser);
    }).observe(saved, {attributes:true, attributeFilter:['style']});
  }

  els.edit.addEventListener('click', function(){
    setTimeout(function(){
      window.scrollTo({top:0});
      var panel = document.getElementById('authPanel');
      if (panel && panel.style.display === 'none') document.getElementById('auth-toggle').click();
    }, 0);
  });
  els.logout.addEventListener('click', function(){ auth.signOut(); });
})();
</script>
<script id="mz-photo">
(function(){
  var btn = document.getElementById('profilePhotoBtn');
  var rm = document.getElementById('profilePhotoRemove');
  var file = document.getElementById('profilePhotoFile');
  var input = document.getElementById('profilePhotoInput');
  var hint = document.getElementById('profilePhotoHint');
  var preview = document.getElementById('profileAvatarPreview');
  var nameInput = document.getElementById('profileNameInput');
  if (!btn || !file || !input) return;

  function say(msg) {
    hint.textContent = msg;
    hint.style.display = msg ? 'block' : 'none';
  }

  function toSquare(f, size, cb) {
    var reader = new FileReader();
    reader.onload = function() {
      var img = new Image();
      img.onload = function() {
        var c = document.createElement('canvas');
        c.width = c.height = size;
        var side = Math.min(img.width, img.height);
        c.getContext('2d').drawImage(img, (img.width - side) / 2, (img.height - side) / 2, side, side, 0, 0, size, size);
        cb(c.toDataURL('image/jpeg', 0.85));
      };
      img.onerror = function() { cb(null); };
      img.src = reader.result;
    };
    reader.onerror = function() { cb(null); };
    reader.readAsDataURL(f);
  }

  btn.addEventListener('click', function() { file.click(); });

  file.addEventListener('change', function() {
    var f = file.files && file.files[0];
    if (!f) return;
    if (f.type && f.type.indexOf('image/') !== 0) { say('File harus berupa gambar.'); return; }
    say('Memproses foto...');
    toSquare(f, 256, function(data) {
      file.value = '';
      if (!data) { say('Foto tidak bisa dibaca. Coba foto lain (JPG atau PNG).'); return; }
      input.value = data;
      renderAvatar(preview, nameInput.value, data);
      say('Foto dipilih. Tekan Simpan Profil.');
    });
  });

  rm.addEventListener('click', function() {
    input.value = '';
    renderAvatar(preview, nameInput.value, '');
    say('Foto dihapus. Tekan Simpan Profil.');
  });
})();
</script>
<script id="mz-badge-js">
(function(){
  var PERSON = '<svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 4-6 8-6s8 2 8 6"/></svg>';
  ['badgeAvatar','upAvatar'].forEach(function(id){
    var el = document.getElementById(id);
    if (!el) return;
    function fix(){ if (el.textContent.trim() === '?') el.innerHTML = PERSON; }
    fix();
    new MutationObserver(fix).observe(el, {childList:true, characterData:true, subtree:true});
  });
})();
</script>
<script id="mz-login">
(function(){
  if (typeof auth === 'undefined' || typeof firebase === 'undefined') return;
  var label = document.getElementById('authToggleLabel');
  var box = document.getElementById('authProviders');
  var errEl = document.getElementById('authError');

  var MSG = {
    'auth/operation-not-allowed': 'Metode masuk ini belum diaktifkan di Firebase.',
    'auth/unauthorized-domain': 'Domain web ini belum didaftarkan di Firebase (Authorized domains).',
    'auth/network-request-failed': 'Koneksi bermasalah, coba lagi.',
    'auth/account-exists-with-different-credential': 'Email ini sudah terdaftar lewat metode lain. Masuk pakai metode yang dulu dipakai.',
    'auth/web-storage-unsupported': 'Browser memblokir penyimpanan. Coba buka di Chrome biasa.'
  };

  function showErr(m){ errEl.textContent = m; errEl.style.display = 'block'; }
  function clearErr(){ errEl.style.display = 'none'; }
  function setBusy(b){
    document.querySelectorAll('.auth-prov').forEach(function(x){ x.disabled = b; });
  }

  var makers = {
    google: function(){
      var p = new firebase.auth.GoogleAuthProvider();
      p.setCustomParameters({ prompt: 'select_account' });
      return p;
    },
    github: function(){ return new firebase.auth.GithubAuthProvider(); }
  };

  async function signIn(provider){
    clearErr();
    setBusy(true);
    try {
      await auth.signInWithPopup(provider);
    } catch (e) {
      if (e.code === 'auth/popup-closed-by-user' || e.code === 'auth/cancelled-popup-request') {
        // dibatalkan, tidak perlu pesan
      } else if (e.code === 'auth/popup-blocked') {
        try { await auth.signInWithRedirect(provider); return; }
        catch (e2) { showErr(MSG[e2.code] || e2.message || 'Masuk gagal.'); }
      } else {
        showErr(MSG[e.code] || e.message || 'Masuk gagal.');
      }
    } finally {
      setBusy(false);
    }
  }

  document.querySelectorAll('[data-provider]').forEach(function(b){
    b.addEventListener('click', function(){
      var make = makers[b.dataset.provider];
      if (make) signIn(make());
    });
  });

  auth.getRedirectResult().catch(function(e){
    if (e && e.code) showErr(MSG[e.code] || e.message || 'Masuk gagal.');
  });

  // Buat profil otomatis saat pertama kali masuk
  async function ensureProfile(user){
    try {
      var ref = db.collection('users').doc(user.uid);
      var snap = await ref.get();
      if (snap.exists) return false;
      await ref.set({
        name: user.displayName || user.email || 'Pengguna',
        email: user.email || '',
        photoURL: user.photoURL || '',
        isAdmin: false,
        createdAt: firebase.firestore.FieldValue.serverTimestamp()
      });
      return true;
    } catch (e) { return false; }
  }

  auth.onAuthStateChanged(async function(user){
    if (label) label.textContent = user ? 'Akun Saya' : 'Masuk';
    if (box) box.style.display = user ? 'none' : 'flex';
    if (user) {
      var created = await ensureProfile(user);
      if (created) location.reload();
    }
  });
})();
</script>
<script id="mz-side-js">
(function(){
  var sb = document.getElementById('sidebar');
  var ov = document.getElementById('sidebarOverlay');
  if (!sb) return;
  function sync(){
    document.documentElement.classList.toggle('mz-lock', sb.classList.contains('active'));
  }
  new MutationObserver(sync).observe(sb, {attributes:true, attributeFilter:['class']});
  if (ov) ov.addEventListener('touchmove', function(e){ e.preventDefault(); }, {passive:false});
  sync();
})();
</script>
<script id="mz-border-js">
(function(){
  if (typeof auth === 'undefined' || typeof db === 'undefined') return;
  var LIST = [
    {id:'none', n:'Polos', cls:''},
    {id:'mono', n:'Hitam/Putih', cls:'bd-s-mono'},
    {id:'biru', n:'Biru', cls:'bd-s-biru'},
    {id:'hijau', n:'Hijau', cls:'bd-s-hijau'},
    {id:'pink', n:'Pink', cls:'bd-s-pink'},
    {id:'ungu', n:'Ungu', cls:'bd-s-ungu'},
    {id:'oranye', n:'Oranye', cls:'bd-s-oranye'},
    {id:'ganda', n:'Ganda', cls:'bd-s-ganda'},
    {id:'putus', n:'Putus', cls:'bd-s-putus'},
    {id:'emas', n:'Emas', cls:'bd-o-emas', owner:true},
    {id:'pelangi', n:'Pelangi', cls:'bd-o-pelangi', owner:true},
    {id:'neon', n:'Neon', cls:'bd-o-neon', owner:true}
  ];
  var MAIN = ['badgeAvatar','upAvatar','profileAvatarPreview'];
  var cur = 'none', admin = false;

  function find(id){ for (var i=0;i<LIST.length;i++) if (LIST[i].id===id) return LIST[i]; return LIST[0]; }
  function setCls(el, id){
    if (!el) return;
    Array.prototype.slice.call(el.classList).forEach(function(c){ if (c.indexOf('bd-')===0) el.classList.remove(c); });
    var b = find(id);
    if (b.cls) el.classList.add(b.cls);
  }
  function applyAll(){ MAIN.forEach(function(id){ setCls(document.getElementById(id), cur); }); }

  function hint(m){
    var h = document.getElementById('bdHint');
    if (!h) return;
    h.textContent = m || '';
    h.style.display = m ? 'block' : 'none';
  }

  function build(){
    var grid = document.getElementById('bdGrid');
    if (!grid) return;
    var ini = ((document.getElementById('profileNameInput') || {}).value || '?').trim().charAt(0).toUpperCase() || '?';
    grid.replaceChildren();
    LIST.forEach(function(b){
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'bd-opt' + (b.id===cur ? ' sel' : '') + ((b.owner && !admin) ? ' lock' : '');
      var dot = document.createElement('span');
      dot.className = 'bd-dot' + (b.cls ? ' ' + b.cls : '');
      dot.textContent = ini;
      var lab = document.createElement('div');
      lab.textContent = b.n + (b.owner ? ' ★' : '');
      btn.append(dot, lab);
      btn.addEventListener('click', function(){
        if (b.owner && !admin) { hint('Bingkai bertanda ★ khusus Owner.'); return; }
        hint('');
        cur = b.id;
        setCls(document.getElementById('profileAvatarPreview'), cur);
        build();
      });
      grid.appendChild(btn);
    });
  }

  auth.onAuthStateChanged(async function(user){
    if (!user) { cur = 'none'; admin = false; applyAll(); build(); return; }
    try {
      var doc = await db.collection('users').doc(user.uid).get();
      var d = doc.exists ? doc.data() : {};
      admin = !!d.isAdmin;
      var id = d.avatarBorder || 'none';
      var b = find(id);
      cur = (b.owner && !admin) ? 'none' : b.id;
    } catch (e) { cur = 'none'; }
    applyAll();
    build();
  });

  var save = document.getElementById('profileSaveBtn');
  if (save) save.addEventListener('click', async function(){
    var user = auth.currentUser;
    if (!user) return;
    var b = find(cur);
    if (b.owner && !admin) return;
    try {
      await db.collection('users').doc(user.uid).set({avatarBorder: cur}, {merge:true});
      applyAll();
    } catch (e) {}
  });

  var nm = document.getElementById('profileNameInput');
  if (nm) nm.addEventListener('input', build);
})();
</script>
<script id="mz-anim-js">
(function(){
  var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
  var sel = '.profile-card,.banner,.about-block,.title,.project,.skill,.contact-block,.tool-card';
  var els = document.querySelectorAll(sel);
  if (!reduce && 'IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting) { e.target.classList.add('mz-in'); io.unobserve(e.target); }
      });
    }, {threshold:.12, rootMargin:'0px 0px -6% 0px'});
    els.forEach(function(el){
      var idx = Array.prototype.indexOf.call(el.parentNode.children, el);
      el.style.transitionDelay = ((idx % 4) * 70) + 'ms';
      el.classList.add('mz-rv');
      io.observe(el);
    });
  }
  var ticking = false;
  window.addEventListener('scroll', function(){
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(function(){
      document.body.classList.toggle('mz-scrolled', window.scrollY > 8);
      ticking = false;
    });
  }, {passive:true});
})();
</script>
<script id="mz-settings-ui">
(function(){
  var S = window.mzSettings;
  if (!S) return;
  var sw = document.getElementById('mzSwatches');
  var fo = document.getElementById('mzFonts');
  var rs = document.getElementById('mzReset');
  if (!sw || !fo) return;

  var previewLoaded = false;
  function loadPreview(){
    if (previewLoaded) return;
    previewLoaded = true;
    var l = document.createElement('link');
    l.rel = 'stylesheet';
    l.href = 'https://fonts.googleapis.com/css2?family=Poppins:wght@600&family=Nunito:wght@700&family=Space+Grotesk:wght@600&family=Merriweather:wght@700&family=JetBrains+Mono:wght@700&display=swap';
    document.head.appendChild(l);
  }

  function render(){
    var st = S.get();
    sw.replaceChildren();
    S.THEMES.forEach(function(t){
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'mz-sw' + (t.id === st.theme ? ' sel' : '');
      var dot = document.createElement('span');
      dot.className = 'mz-dot';
      dot.style.background = t.l ? t.l : 'linear-gradient(135deg,#0a0a0a 50%,#f5f5f5 50%)';
      var lb = document.createElement('span');
      lb.textContent = t.n;
      b.append(dot, lb);
      b.addEventListener('click', function(){ S.set({theme: t.id}); render(); });
      sw.appendChild(b);
    });

    fo.replaceChildren();
    S.FONTS.forEach(function(f){
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'mz-fo' + (f.id === st.font ? ' sel' : '');
      var name = document.createElement('b');
      name.textContent = f.n;
      var sm = document.createElement('small');
      sm.textContent = 'Aa Bb Cc 123 - Santai dulu, main game.';
      if (f.css) { name.style.fontFamily = f.css; sm.style.fontFamily = f.css; }
      b.append(name, sm);
      b.addEventListener('click', function(){ S.set({font: f.id}); render(); });
      fo.appendChild(b);
    });
  }

  if (rs) rs.addEventListener('click', function(){ S.set({theme: 'mono', font: 'bawaan'}); render(); });

  document.querySelectorAll('[data-tab="tab-pengaturan"]').forEach(function(b){
    b.addEventListener('click', loadPreview);
  });

  var fr = document.getElementById('toolFrame');
  if (fr) fr.addEventListener('load', function(){
    try { S.applyTo(fr.contentDocument); } catch (e) {}
  });

  render();
})();
</script>
</body>
</html>
