<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#080811">
<meta name="description" content="Mann'zz — Portfolio & Tools">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/devicon@2.16.0/devicon.min.css">
<title>Mann'zz</title>
<link rel="icon" type="image/png" href="favicon.png">
<link rel="apple-touch-icon" href="favicon.png">
<style>
:root{--purple:#2563eb;--accent:#2563eb}
body{--bg:#0a0a0a;--card:#141414;--line:#2a2a2a;--text:#f5f5f5;--muted:#9ca3af;--shadow:rgba(0,0,0,.5)}
body.light-mode{--bg:#ffffff;--card:#f7f7f8;--line:#e5e5e5;--text:#0a0a0a;--muted:#6b7280;--shadow:rgba(0,0,0,.12)}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;min-height:100vh;background:var(--bg);color:var(--text);font:16px/1.6 system-ui,-apple-system,sans-serif;transition:background .2s,color .2s}
a{color:inherit;text-decoration:none}
.container{width:min(480px,100%);margin:0 auto;padding:0 16px}
@media(min-width:768px){
  .container{width:min(820px,92%)}
}
@media(min-width:1100px){
  .container{width:min(1080px,90%)}
  .projects{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:18px}
  .bottom-nav{max-width:520px}
}
@media(min-width:1400px){
  .container{width:min(1200px,88%)}
}
.btn{display:inline-block;padding:11px 17px;border:1px solid var(--line);border-radius:10px;font-weight:700;cursor:pointer;background:transparent;color:inherit;font:inherit;transition:transform .12s ease}
.btn.primary{background:var(--accent);color:#fff;box-shadow:0 4px 18px var(--shadow)}
.btn:active{transform:scale(.95)}
header{position:sticky;top:0;z-index:10;background:var(--bg);border-bottom:1px solid var(--line)}
.topbar{display:flex;align-items:center;justify-content:space-between;height:64px}
.logo{display:flex;align-items:center;gap:8px;font-weight:900;font-size:1.1rem}
.verified-badge{display:inline-flex;align-items:center;justify-content:center;color:#25d366;vertical-align:middle}
.verified-badge .badge-icon{width:18px;height:18px}
.verified-badge.owner-role{color:#1d9bf0}
.topbar-actions{display:flex;align-items:center;gap:8px}
.owner-badge{font-size:.65rem;font-weight:800;padding:4px 10px;border-radius:20px;border:1px solid var(--line);background:var(--card)}
.owner-badge.owner-role{background:linear-gradient(110deg,#8a6500 20%,#ffd700 40%,#fff8dc 50%,#ffd700 60%,#8a6500 80%);color:#2a1e00}
#theme-toggle,#auth-toggle{background:var(--card);border:1px solid var(--line);color:var(--text);border-radius:8px;padding:8px 10px;cursor:pointer;font-size:1rem}
.owner-panel{max-width:480px;margin:0 auto;padding:14px 16px;background:var(--card);border-bottom:1px solid var(--line);display:flex;flex-direction:column;gap:10px}
.pass-wrap{position:relative}
.pass-wrap input{width:100%;padding:12px;padding-right:42px;border-radius:9px;border:1px solid var(--line);background:var(--bg);color:var(--text);font:inherit}
.pass-eye{position:absolute;right:8px;top:50%;transform:translateY(-50%);background:transparent;border:none;font-size:1.1rem;cursor:pointer;color:var(--text)}
.gate-error{color:#e23}
.app{padding:18px 16px 24px}
.tab{display:none}
.tab.active{display:block}
.profile-card{border:1px solid var(--line);border-radius:16px;background:var(--card);box-shadow:0 4px 18px var(--shadow);padding:18px;margin-bottom:16px}
.profile-top{display:flex;gap:12px;align-items:center}
.avatar{width:54px;height:54px;border-radius:50%;background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:1.1rem;flex-shrink:0;overflow:hidden}
.avatar img{width:100%;height:100%;object-fit:cover;display:block}
.profile-name{font-weight:900;font-size:1.1rem}
.profile-bio{color:var(--muted);font-size:.85rem;margin-top:2px}
.verified-badge2{display:inline-flex;align-items:center;justify-content:center;color:#25d366;vertical-align:middle;margin-left:3px}
.verified-badge2 .badge-icon{width:16px;height:16px}
.verified-badge2.owner-role{color:#1d9bf0}
.stat-row{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:16px}
.stat{text-align:center;border:1px solid var(--line);border-radius:10px;padding:10px 4px;background:var(--bg)}
.stat b{display:block;font-size:1.3rem}
.stat span{font-size:.68rem;color:var(--muted);text-transform:uppercase;letter-spacing:.03em}
.banner{display:flex;align-items:center;justify-content:space-between;background:var(--card);border-left:4px solid var(--accent);border:1px solid var(--line);border-radius:16px;padding:16px 18px;margin-bottom:16px;box-shadow:0 4px 18px var(--shadow)}
.banner-tag{background:var(--accent);color:#fff;font-size:.65rem;font-weight:800;padding:3px 9px;border-radius:12px}
.banner-title{color:var(--text);font-weight:900;font-size:1.05rem;margin-top:6px}
.banner-sub{color:var(--muted);font-size:.78rem}
.banner-icon{font-size:1.8rem}
.about-block .title{font-size:1.2rem;margin:0 0 10px}
.muted{color:var(--muted)}
.quote{margin-top:14px;padding:16px;border:1px solid var(--line);border-radius:12px;background:var(--card)}
.quote p{font-weight:800;font-style:italic;margin:0 0 4px;color:var(--purple)}
.title{font-size:1.3rem;margin:0 0 16px}
.projects{display:flex;flex-direction:column;gap:14px}
.project{border:1px solid var(--line);border-radius:14px;background:var(--card);box-shadow:0 4px 18px var(--shadow);padding:16px}
.project-media{border-radius:10px;overflow:hidden;margin-bottom:12px;border:1px solid var(--line)}
.project-media video{width:100%;display:block;aspect-ratio:16/9;object-fit:cover}
.project h3{margin:0 0 6px}
.project p{font-size:.85rem;color:var(--muted);margin:0 0 10px}
.tag{display:inline-block;background:#2563eb22;border:1px solid #2563eb;color:#ffffff;border-radius:20px;padding:2px 9px;font-size:.72rem;margin:2px 4px 2px 0}
.project-links a{font-size:.78rem;font-weight:700;padding:6px 12px;border-radius:8px;border:1px solid var(--line);display:inline-block;margin-top:6px}
.skills{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:24px}
.skill{border:1px solid var(--line);border-radius:12px;background:var(--card);box-shadow:0 4px 18px var(--shadow);text-align:center;padding:14px 4px;font-size:.78rem;font-weight:700}
.skill i{display:block;font-size:1.5rem;margin-bottom:5px}
.contact-block form{display:flex;flex-direction:column;gap:10px;margin-top:12px}
.contact-block input,.contact-block textarea{padding:12px;border-radius:9px;border:1px solid var(--line);background:var(--card);color:var(--text);font:inherit}
.contact-block textarea{min-height:100px}
.contact-block button{border:1px solid var(--line);box-shadow:0 4px 18px var(--shadow);border-radius:9px;padding:12px;font-weight:800;cursor:pointer;background:var(--accent);color:#fff;transition:transform .12s ease}
.contact-block button:active{transform:scale(.96)}
#status{font-size:.82rem;color:var(--purple)}
.tool-card{display:flex;gap:14px;align-items:center;border:1px solid var(--line);border-radius:14px;background:var(--card);box-shadow:0 4px 18px var(--shadow);padding:16px;margin-bottom:12px}
.tool-icon{font-size:1.8rem}
.tool-card h3{margin:0 0 4px}
.tool-card p{margin:0;font-size:.82rem;color:var(--muted)}
.bottom-nav{position:fixed;left:16px;right:16px;bottom:16px;z-index:20;display:flex;align-items:flex-end;justify-content:space-around;background:var(--card);border:1px solid var(--line);border-radius:30px;padding:10px 6px;box-shadow:0 8px 24px rgba(0,0,0,.4);max-width:448px;margin:0 auto}
.nav-btn{background:none;border:none;color:var(--muted);font:inherit;font-size:.62rem;display:flex;flex-direction:column;align-items:center;gap:4px;cursor:pointer;flex:1;padding:4px;transition:margin-top .3s cubic-bezier(.34,1.56,.64,1),color .25s ease}
.nav-btn span{width:34px;height:34px;display:flex;align-items:center;justify-content:center;border-radius:50%;background:transparent;box-shadow:none;border:3px solid transparent;transition:all .3s cubic-bezier(.34,1.56,.64,1)}
.nav-btn span .icon{width:22px;height:22px;transition:width .3s ease,height .3s ease}
.nav-btn.active{color:var(--text);font-weight:700}
.nav-btn.home{margin-top:-30px;color:var(--text)}
.nav-btn.home span{width:52px;height:52px;background:var(--accent);color:#fff;box-shadow:0 6px 16px #1d4ed866;border:3px solid var(--bg)}
.nav-btn.home span .icon{width:24px;height:24px;stroke:#fff}
#menu-toggle{background:var(--card);border:1px solid var(--line);color:var(--text);border-radius:8px;padding:8px 10px;cursor:pointer;font-size:1rem}
#menu-toggle .icon{width:18px;height:18px}
.sidebar-overlay{position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:69;opacity:0;pointer-events:none;transition:opacity .25s ease}
.sidebar-overlay.active{opacity:1;pointer-events:auto}
.sidebar{position:fixed;top:0;left:0;bottom:0;width:260px;max-width:82vw;background:var(--card);border-right:1px solid var(--line);z-index:70;transform:translateX(-100%);transition:transform .3s ease;display:flex;flex-direction:column;padding:16px;overflow-y:auto}
.sidebar.active{transform:translateX(0)}
.sidebar-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;font-weight:900}
#sidebar-close{background:none;border:none;color:var(--text);cursor:pointer}
#sidebar-close .icon{width:20px;height:20px}
.sidebar-nav{display:flex;flex-direction:column;gap:4px}
.sidebar-nav .nav-btn{flex-direction:row;justify-content:flex-start;align-items:center;gap:12px;width:100%;padding:12px 14px;border-radius:10px;font-size:.92rem;font-weight:600;color:var(--muted);margin-top:0!important}
.sidebar-nav .nav-btn span{width:22px;height:22px;background:transparent!important;border:none!important;box-shadow:none!important}
.sidebar-nav .nav-btn.active{background:var(--line);color:var(--text)}
.sidebar-nav .nav-btn .icon{stroke:currentColor}
.skill-badge{display:flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:50%;color:#fff;font-weight:800;font-size:.68rem;margin:0 auto 6px}
.skill{display:flex;flex-direction:column;align-items:center;justify-content:center}
.title{position:relative;padding-left:14px}
.title::before{content:'';position:absolute;left:0;top:3px;bottom:3px;width:4px;border-radius:3px;background:var(--accent)}
body::before{content:'';position:fixed;top:0;left:0;right:0;height:380px;background:radial-gradient(circle at 20% 0%,rgba(79,70,229,.14),transparent 60%);pointer-events:none;z-index:0}
.container{position:relative}
footer{text-align:center;color:var(--muted);font-size:.75rem;padding:18px 0 32px}

.icon{stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;display:block}
.nav-btn .icon{width:22px;height:22px}
.nav-btn.home .icon{width:24px;height:24px}
.tool-icon{color:var(--purple);display:flex}
.tool-icon .icon{width:26px;height:26px}
.banner-icon{color:var(--accent)}
.banner-icon .icon{width:30px;height:30px}
#theme-toggle .icon,#auth-toggle .icon{width:18px;height:18px}
.pass-eye .icon{width:18px;height:18px}

.icon-inline{display:inline-flex;vertical-align:-3px;margin-right:5px}
.icon-inline .icon{width:16px;height:16px}
.owner-badge .icon{width:12px;height:12px;display:inline-block;vertical-align:-1px;margin-right:3px}
.verified-badge .icon,.verified-badge2 .icon{width:65%;height:65%;stroke:#fff;stroke-width:3}

.game-frame{width:100%;min-height:72vh;border:1px solid var(--line);border-radius:14px;background:var(--card);box-shadow:0 4px 18px var(--shadow)}
.tool-overlay{position:fixed;inset:0;z-index:60;background:var(--bg);display:none;flex-direction:column;overscroll-behavior:contain}
.tool-overlay.active{display:flex}
.tool-overlay-bar{padding:12px 16px;border-bottom:1px solid var(--line);background:var(--card)}
.tool-overlay-bar button{background:none;border:none;color:var(--text);font:inherit;font-weight:700;font-size:.9rem;display:flex;align-items:center;gap:6px;cursor:pointer}
.tool-overlay-bar button .icon{width:18px;height:18px}
#toolFrame{flex:1;border:none;width:100%;overscroll-behavior:contain}
.tool-card{cursor:pointer}

.wa-fab{position:fixed;right:16px;bottom:24px;z-index:25;width:52px;height:52px;border-radius:50%;background:#25d366;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 16px rgba(0,0,0,.45);border:3px solid var(--bg);animation:wa-bounce 2.6s ease-in-out infinite}
.wa-fab:active{transform:scale(.88)}
.wa-fab::before{content:'';position:absolute;inset:0;border-radius:50%;background:#25d366;z-index:-1;animation:wa-ping 2.6s cubic-bezier(0,0,.2,1) infinite}
@keyframes wa-ping{0%{transform:scale(1);opacity:.55}100%{transform:scale(1.9);opacity:0}}
@keyframes wa-bounce{0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}
.auth-tabs{display:flex;gap:8px}
.auth-tab{flex:1;padding:8px;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:var(--muted);font:inherit;font-weight:700;cursor:pointer}
.auth-tab.active{color:var(--text);border-color:var(--purple)}
.auth-form{display:flex;flex-direction:column;gap:10px}
.owner-panel input[type="text"],.owner-panel input[type="email"]{width:100%;padding:12px;border-radius:9px;border:1px solid var(--line);background:var(--bg);color:var(--text);font:inherit}
.badge-avatar{display:inline-flex;align-items:center;justify-content:center;width:20px;height:20px;border-radius:50%;background:var(--accent);color:#fff;font-size:.65rem;font-weight:800;overflow:hidden;vertical-align:-5px;margin-right:6px}
.badge-avatar img{width:100%;height:100%;object-fit:cover;display:block}
.avatar-preview-large{width:64px;height:64px;border-radius:50%;background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;font-size:1.4rem;font-weight:800;overflow:hidden;margin:0 auto 10px}
.avatar-preview-large img{width:100%;height:100%;object-fit:cover;display:block}
.profile-editor{display:flex;flex-direction:column;gap:10px;padding-bottom:10px;border-bottom:1px solid var(--line);margin-bottom:10px}
</style>
<style>
input[placeholder*="foto" i]{display:block;width:100%;box-sizing:border-box;padding:14px 16px;margin:12px 0;font:inherit;font-size:1rem;color:#111;background:#fffbea;border:1px solid var(--line);border-radius:12px;outline:none}
input[placeholder*="foto" i]:focus{box-shadow:0 4px 18px var(--shadow)}
</style><link rel="manifest" href="/manifest.json"><meta name="theme-color" content="#080811"><link rel="apple-touch-icon" href="/icon-192.png"><style id="mz-bw">
html body:not(.light-mode){--accent:#f5f5f5;--purple:#f5f5f5;--on:#0a0a0a}
html body.light-mode{--accent:#0a0a0a;--purple:#0a0a0a;--on:#fff}
html body .btn.primary,html body .banner-tag,html body .avatar,html body .contact-block button,html body .badge-avatar,html body .avatar-preview-large{color:var(--on)!important}
html body .bottom-nav .nav-btn.home span .icon{stroke:var(--on)!important}
html body .bottom-nav .nav-btn.home span{box-shadow:0 6px 16px rgba(0,0,0,.35)!important}
html body .tag{background:rgba(128,128,128,.14)!important;border-color:var(--line)!important;color:var(--text)!important}
html body::before{background:radial-gradient(circle at 20% 0%,rgba(128,128,128,.12),transparent 60%)!important}
</style>
<style id="mz-badge">
html body .owner-badge{display:inline-flex!important;align-items:center!important;gap:8px!important;padding:4px 14px 4px 4px!important;font-size:.78rem!important;font-weight:700!important;line-height:1!important;white-space:nowrap!important;border-radius:999px!important}
html body .owner-badge .badge-avatar{width:28px!important;height:28px!important;margin:0!important;vertical-align:baseline!important;font-size:.8rem!important;flex-shrink:0!important}
html body #badgeText{display:inline-flex!important;align-items:center!important;gap:4px!important;line-height:1!important}
html body .owner-badge .badge-avatar svg,html body #upAvatar svg{width:58%;height:58%;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
</style>
<style id="mz-login">
html body .auth-tabs,html body #authLoginForm,html body #authRegisterForm{display:none!important}
html body .sidebar{overflow:hidden!important}
html body .sidebar-nav{flex:1 1 auto;min-height:0;overflow-y:auto}
html body .sidebar-foot{flex-shrink:0;margin-top:12px;padding-top:12px;border-top:1px solid var(--line)}
html body .sidebar-foot svg{width:20px;height:20px}
html body .auth-prov{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;padding:12px 14px;border-radius:10px;border:1px solid var(--line);background:var(--bg);color:var(--text);font:inherit;font-weight:700;cursor:pointer}
html body .auth-prov svg{width:20px;height:20px;flex-shrink:0}
html body .auth-prov:active{transform:scale(.97)}
html body .auth-prov:disabled{opacity:.6}
</style>
<style id="mz-side">
html body .sidebar{top:0!important;bottom:auto!important;height:100vh!important;height:100dvh!important;overflow:hidden!important;overscroll-behavior:contain}
html body .sidebar-head{margin-bottom:10px!important;flex-shrink:0}
html body .sidebar-nav{flex:0 1 auto!important;min-height:0;overflow-y:auto;overscroll-behavior:contain;gap:2px!important}
html body .sidebar-nav .nav-btn{flex:0 0 auto!important;padding:10px 12px!important;font-size:.9rem!important;margin-top:0!important}
html body .sidebar-nav .nav-btn span{width:22px!important;height:22px!important}
html body .sidebar-foot{margin-top:auto!important;flex-shrink:0}
html.mz-lock,html.mz-lock body{overflow:hidden!important}
</style>
<style id="mz-owner">
html body .owner-badge.owner-role{background:var(--card)!important;background-image:none!important;color:var(--text)!important;border:1px solid var(--line)!important;animation:none!important;text-shadow:none!important;box-shadow:none!important}
html body .owner-badge.owner-role *{animation:none!important;text-shadow:none!important}
</style>
<style id="mz-border">
@property --ang{syntax:'<angle>';inherits:false;initial-value:0deg}
html body #badgeAvatar{--r:1.5px;--r2:2px}
html body [class*="bd-s-"]{box-shadow:0 0 0 var(--r,3px) var(--bg),0 0 0 calc(var(--r,3px)*2) var(--bc,var(--text))}
html body .bd-s-mono{--bc:var(--text)}
html body .bd-s-biru{--bc:#2563eb}
html body .bd-s-hijau{--bc:#22c55e}
html body .bd-s-pink{--bc:#ec4899}
html body .bd-s-ungu{--bc:#8b5cf6}
html body .bd-s-oranye{--bc:#f97316}
html body .bd-s-ganda{box-shadow:0 0 0 var(--r,3px) var(--bg),0 0 0 calc(var(--r,3px)*2) var(--text),0 0 0 calc(var(--r,3px)*3) var(--bg),0 0 0 calc(var(--r,3px)*4) var(--text)}
html body .bd-s-putus{box-shadow:none;outline:var(--r,3px) dashed var(--text);outline-offset:calc(var(--r,3px)*1.2)}
html body .bd-o-emas,html body .bd-o-pelangi{border:var(--r2,3px) solid transparent!important;animation:mzSpin 3s linear infinite}
html body .bd-o-emas{background:linear-gradient(var(--accent),var(--accent)) padding-box,conic-gradient(from var(--ang),#8a6500,#ffd700,#fff8dc,#ffd700,#8a6500) border-box!important}
html body .bd-o-pelangi{background:linear-gradient(var(--accent),var(--accent)) padding-box,conic-gradient(from var(--ang),#ef4444,#f59e0b,#22c55e,#06b6d4,#8b5cf6,#ec4899,#ef4444) border-box!important}
html body .bd-o-neon{box-shadow:0 0 0 var(--r,3px) var(--bg),0 0 0 calc(var(--r,3px)*2) #22d3ee,0 0 14px 4px rgba(34,211,238,.6);animation:mzPulse 1.6s ease-in-out infinite alternate}
@keyframes mzSpin{to{--ang:360deg}}
@keyframes mzPulse{to{box-shadow:0 0 0 var(--r,3px) var(--bg),0 0 0 calc(var(--r,3px)*2) #ec4899,0 0 16px 5px rgba(236,72,153,.6)}}
html body .bd-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
html body .bd-opt{background:none;border:none;color:var(--text);font:inherit;font-size:.68rem;cursor:pointer;padding:8px 2px;text-align:center;border-radius:10px}
html body .bd-opt.sel{background:var(--card);outline:1px solid var(--accent)}
html body .bd-opt.lock{opacity:.45}
html body .bd-dot{width:38px;height:38px;border-radius:50%;background:var(--accent);color:var(--on);display:flex;align-items:center;justify-content:center;font-weight:800;margin:0 auto 8px;--r:2px;--r2:3px}
html body .mz-rv{opacity:0;transform:translateY(26px) scale(.98);transition:opacity .6s ease,transform .6s cubic-bezier(.2,.7,.2,1)}
html body .mz-rv.mz-in{opacity:1;transform:none}
html body .tab.active{animation:mzTab .4s ease}
@keyframes mzTab{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
html body header{transition:box-shadow .3s ease}
html body.mz-scrolled header{box-shadow:0 6px 18px var(--shadow)}
@media(prefers-reduced-motion:reduce){html body .mz-rv{opacity:1!important;transform:none!important;transition:none!important}html body .tab.active,html body [class*="bd-o-"]{animation:none!important}}
</style>
<style id="mz-sidelinks">
html body .mz-sidelinks{display:flex;gap:10px;margin-bottom:10px}
html body .mz-sl{flex:1 1 0;min-width:0;display:flex;align-items:center;justify-content:center;gap:8px;padding:11px 8px;border-radius:10px;border:1px solid var(--line);background:var(--bg);color:var(--text);font:inherit;font-weight:700;font-size:.85rem;text-decoration:none;cursor:pointer}
html body .mz-sl svg{width:18px;height:18px;flex-shrink:0}
html body .mz-sl:active{transform:scale(.96)}
</style>
<style id="mz-nofab">.wa-fab{display:none!important}</style>
<style id="mz-settings-css">
html body .mz-sw-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
html body .mz-sw{background:var(--bg);border:1px solid var(--line);border-radius:12px;padding:10px 4px;color:var(--text);font:inherit;font-size:.7rem;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:6px}
html body .mz-sw.sel,html body .mz-fo.sel{outline:2px solid var(--text);outline-offset:1px}
html body .mz-dot{width:30px;height:30px;border-radius:50%;border:1px solid var(--line)}
html body .mz-fo-list{display:flex;flex-direction:column;gap:8px}
html body .mz-fo{text-align:left;background:var(--bg);border:1px solid var(--line);border-radius:12px;padding:12px 14px;color:var(--text);cursor:pointer;font:inherit}
html body .mz-fo b{display:block;font-size:1rem}
html body .mz-fo small{display:block;color:var(--muted);margin-top:2px}
</style>
<script id="mz-settings-boot">
(function(){
  var KEY = 'mz_settings';
  var THEMES = [
    {id:'mono', n:'Hitam/Putih'},
    {id:'biru', n:'Biru', l:'#2563eb', d:'#3b82f6', ol:'#fff', od:'#fff'},
    {id:'hijau', n:'Hijau', l:'#16a34a', d:'#22c55e', ol:'#fff', od:'#0a0a0a'},
    {id:'kuning', n:'Kuning', l:'#eab308', d:'#facc15', ol:'#0a0a0a', od:'#0a0a0a'},
    {id:'pink', n:'Pink', l:'#ec4899', d:'#f472b6', ol:'#fff', od:'#0a0a0a'},
    {id:'ungu', n:'Ungu', l:'#7c3aed', d:'#a78bfa', ol:'#fff', od:'#0a0a0a'},
    {id:'oranye', n:'Oranye', l:'#ea580c', d:'#fb923c', ol:'#fff', od:'#0a0a0a'}
  ];
  var FONTS = [
    {id:'bawaan', n:'Bawaan', css:''},
    {id:'poppins', n:'Poppins', css:"'Poppins',sans-serif", gf:'Poppins:wght@400;600;800'},
    {id:'nunito', n:'Nunito', css:"'Nunito',sans-serif", gf:'Nunito:wght@400;700;900'},
    {id:'space', n:'Space Grotesk', css:"'Space Grotesk',sans-serif", gf:'Space+Grotesk:wght@400;600;700'},
    {id:'merri', n:'Merriweather', css:"'Merriweather',serif", gf:'Merriweather:wght@400;700;900'},
    {id:'kode', n:'JetBrains Mono', css:"'JetBrains Mono',monospace", gf:'JetBrains+Mono:wght@400;700;800'}
  ];

  function find(list, id){
    for (var i = 0; i < list.length; i++) if (list[i].id === id) return list[i];
    return list[0];
  }

  var state = {theme:'mono', font:'bawaan'};
  try {
    var saved = JSON.parse(localStorage.getItem(KEY) || '{}');
    if (saved.theme) state.theme = find(THEMES, saved.theme).id;
    if (saved.font) state.font = find(FONTS, saved.font).id;
  } catch (e) {}

  function build(st){
    var t = find(THEMES, st.theme), f = find(FONTS, st.font), out = '';
    if (t.l) {
      out += 'html[data-mz-accent] body:not(.light-mode){--accent:' + t.d + ';--purple:' + t.d + ';--gold:' + t.d + ';--on:' + t.od + '}';
      out += 'html[data-mz-accent] body.light-mode{--accent:' + t.l + ';--purple:' + t.l + ';--gold:' + t.l + ';--on:' + t.ol + '}';
    }
    if (f.css) {
      out += 'html[data-mz-font] body,html[data-mz-font] body button:not(.mz-fo),html[data-mz-font] body input,html[data-mz-font] body textarea{font-family:' + f.css + '!important}';
    }
    return out;
  }

  function apply(doc, st){
    if (!doc || !doc.documentElement) return;
    var h = doc.documentElement;
    var t = find(THEMES, st.theme), f = find(FONTS, st.font);
    if (t.l) h.setAttribute('data-mz-accent', t.id); else h.removeAttribute('data-mz-accent');
    if (f.css) h.setAttribute('data-mz-font', f.id); else h.removeAttribute('data-mz-font');
    var head = doc.head || h;
    var el = doc.getElementById('mz-user-css');
    if (!el) { el = doc.createElement('style'); el.id = 'mz-user-css'; head.appendChild(el); }
    el.textContent = build(st);
    var lk = doc.getElementById('mz-user-font');
    if (f.gf) {
      var href = 'https://fonts.googleapis.com/css2?family=' + f.gf + '&display=swap';
      if (!lk) { lk = doc.createElement('link'); lk.id = 'mz-user-font'; lk.rel = 'stylesheet'; head.appendChild(lk); }
      if (lk.getAttribute('href') !== href) lk.setAttribute('href', href);
    } else if (lk) {
      lk.remove();
    }
  }

  window.mzSettings = {
    THEMES: THEMES,
    FONTS: FONTS,
    get: function(){ return {theme: state.theme, font: state.font}; },
    set: function(p){
      if (p.theme) state.theme = find(THEMES, p.theme).id;
      if (p.font) state.font = find(FONTS, p.font).id;
      try { localStorage.setItem(KEY, JSON.stringify(state)); } catch (e) {}
      apply(document, state);
      try {
        var fr = document.getElementById('toolFrame');
        if (fr && fr.contentDocument) apply(fr.contentDocument, state);
      } catch (e) {}
    },
    applyTo: function(doc){ apply(doc, state); }
  };

  apply(document, state);
})();
</script>
</head>
