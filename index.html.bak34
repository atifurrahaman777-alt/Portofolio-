html body .bd-a-sayap::after{content:""!important;background:url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2060%2040%22%3E%3Cdefs%3E%3ClinearGradient%20id%3D%22w%22%20x1%3D%220%22%20y1%3D%220%22%20x2%3D%221%22%20y2%3D%221%22%3E%3Cstop%20offset%3D%220%22%20stop-color%3D%22%23ffffff%22%2F%3E%3Cstop%20offset%3D%221%22%20stop-color%3D%22%23c9d6e8%22%2F%3E%3C%2FlinearGradient%3E%3C%2Fdefs%3E%3Cpath%20d%3D%22M2%2020C14%204%2038%202%2058%208C48%2010%2042%2013%2038%2016C46%2015%2052%2016%2058%2019C48%2021%2042%2024%2038%2027C44%2027%2050%2029%2055%2032C45%2033%2038%2035%2030%2037C20%2038%208%2032%202%2020Z%22%20fill%3D%22url%28%23w%29%22%20stroke%3D%22%23aebdd6%22%20stroke-width%3D%22.7%22%20stroke-linejoin%3D%22round%22%2F%3E%3Cg%20fill%3D%22none%22%20stroke%3D%22%23aebdd6%22%20stroke-width%3D%22.8%22%20stroke-linecap%3D%22round%22%3E%3Cpath%20d%3D%22M6%2020C18%2014%2034%2012%2054%2010%22%2F%3E%3Cpath%20d%3D%22M8%2024C20%2021%2034%2020%2052%2020%22%2F%3E%3Cpath%20d%3D%22M12%2028C22%2027%2034%2027%2048%2030%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E") center/contain no-repeat!important;width:calc(var(--sz,40px)*.9)!important;height:calc(var(--sz,40px)*.6)!important;font-size:0!important;border:none!important;border-radius:0!important;clip-path:none!important;top:0%!important;right:-84%!important;bottom:auto!important;left:auto!important;transform:none!important;}
html body .bd-a-kucing::before,html body .bd-a-kucing::after{content:""!important;background:url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2030%2034%22%3E%3Cdefs%3E%3ClinearGradient%20id%3D%22f%22%20x1%3D%220%22%20y1%3D%220%22%20x2%3D%221%22%20y2%3D%221%22%3E%3Cstop%20offset%3D%220%22%20stop-color%3D%22%239a9aa8%22%2F%3E%3Cstop%20offset%3D%221%22%20stop-color%3D%22%2355555f%22%2F%3E%3C%2FlinearGradient%3E%3C%2Fdefs%3E%3Cpath%20d%3D%22M2%2032C2%2018%206%208%2014%202C22%208%2028%2020%2028%2032Z%22%20fill%3D%22url%28%23f%29%22%20stroke%3D%22%233a3a42%22%20stroke-width%3D%221.2%22%20stroke-linejoin%3D%22round%22%2F%3E%3Cpath%20d%3D%22M8%2030C8%2021%2010%2015%2014%2010C19%2015%2022%2022%2022%2030Z%22%20fill%3D%22%23f4a9bd%22%2F%3E%3Cpath%20d%3D%22M10%2026C10%2021%2012%2017%2014%2014%22%20stroke%3D%22%23fbd0dc%22%20stroke-width%3D%221%22%20fill%3D%22none%22%20stroke-linecap%3D%22round%22%2F%3E%3C%2Fsvg%3E") center/contain no-repeat!important;clip-path:none!important;width:38%!important;height:42%!important}
